# Prefer copying over symlinks so Next.js standalone / OpenNext
# builds are less likely to hit EPERM on Windows.
node-linker=hoisted

# Reject pnpm 10+. This repo uses package.json `pnpm.onlyBuiltDependencies`
# and a pnpm 9 lockfile. pnpm 10 expects `allowBuilds` in pnpm-workspace.yaml.
engine-strict=true
